# Dialer: "mock" replays fixtures offline. "calle" places real calls.
DIALER=mock
PORT=8080
PUBLIC_URL=http://localhost:8080
DB_PATH=./data/broker.db

ANTHROPIC_API_KEY=
CALLE_API_KEY=
CALLE_WEBHOOK_SECRET=dev-secret
CALLER_ID_E164=

MAX_CONCURRENT=5
MAX_LISTINGS_PER_RUN=40
# Set to 1 to ignore the IST calling-window gate during development.
IGNORE_CALL_WINDOW=1
RETRY_DELAY_MIN=1
MOCK_SPEED=40
LOG_LEVEL=warn
NUMBER_COOLDOWN_DAYS=0
AUTH_REQUIRED=0
DEV_AUTH_TOKEN=dev-token
