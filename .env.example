# Dialer:
#   mock   - replays fixtures offline, completes in milliseconds
#   manual - parks each call in `dialing` until you POST the webhook yourself
#            (use this for hand-testing in Postman or curl)
#   calle  - places real calls
DIALER=mock
PORT=8080
PUBLIC_URL=http://localhost:8080
DB_PATH=./data/broker.db

ANTHROPIC_API_KEY=
CALLE_API_KEY=
CALLE_WEBHOOK_SECRET=dev-secret
CALLER_ID_E164=

MAX_CONCURRENT=5
MAX_LISTINGS_PER_RUN=40
# Set to 1 to ignore the IST calling-window gate during development.
IGNORE_CALL_WINDOW=1

# Minutes to wait before the single retry on a no-answer.
# Keep low (1) for mock demos; 30 is right for real calls.
RETRY_DELAY_MIN=30

# Mock only: divides fixture timings so a 20-call run finishes in seconds.
MOCK_SPEED=25

# Cross-run cooldown: do not dial the same number twice within N days.
# Set to 0 for local development so you can re-run the demo; 7 for real runs.
NUMBER_COOLDOWN_DAYS=7

# Google sign-in. Create an OAuth 2.0 Web client at console.cloud.google.com
# and paste the client ID here. No client secret is needed: the browser does the
# sign-in and this server only verifies the resulting token.
GOOGLE_CLIENT_ID=
# 1 makes every run endpoint require a signed-in user. 0 keeps the API open so
# the demo, Postman and the tests work without a Google account.
AUTH_REQUIRED=0
# Fixed token accepted as a session, for automated tests only. Leave empty in prod.
DEV_AUTH_TOKEN=

# CALL-E (https://docs.heycall-e.com). DIALER=calle needs this plus an https
# PUBLIC_URL, because CALL-E delivers results by webhook.
CALLE_BASE_URL=https://api.heycall-e.com
CALL_REGION=IN
CALL_LOCALE=en-IN

# Source fetching. Small on purpose: this reads pages you point it at, it is
# not a crawler.
MAX_SOURCES_PER_REQUEST=10
SOURCE_TIMEOUT_MS=15000
