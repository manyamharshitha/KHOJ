{
  "name": "khoj",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/logic.test.ts && tsx --test test/integration.test.ts",
    "demo": "tsx scripts/demo.ts",
    "replay": "tsx scripts/replay.ts",
    "eval": "tsx eval/score.ts",
    "reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true});console.log('database reset')\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@fastify/cors": "^11.0.1",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
