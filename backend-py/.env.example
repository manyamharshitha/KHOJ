# ---------------------------------------------------------------- service
ENV=dev
PORT=8000
LOG_LEVEL=INFO

# Public https base URL. Twilio dials webhooks here, so localhost cannot work
# once TELEPHONY_PROVIDER=twilio. Use cloudflared / ngrok, or a deployed host.
PUBLIC_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:5173

# --------------------------------------------------------------- firebase
# Leave the credentials file empty on Cloud Run / GCE — the Admin SDK picks up
# ambient application-default credentials there.
# Used for verifying Google ID tokens and signing recording URLs only.
# Documents live in Firestore Enterprise via FIRESTORE_ENTERPRISE_URI above.
FIREBASE_CREDENTIALS_FILE=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ------------------------------------------- database (Firestore Enterprise)
# Firestore Enterprise edition speaks the MongoDB wire protocol, so the data
# layer is a MongoDB driver. Copy the connection string from the database page
# in the Google Cloud console and add the database user you created there.
# The service will refuse to start without this — a backend that boots and then
# fails every write is worse than one that says why immediately.
FIRESTORE_ENTERPRISE_URI=
DATABASE_NAME=khoj_production
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=2
# Create indexes at startup. Turn off where the deploy user cannot issue DDL.
ENSURE_INDEXES_ON_STARTUP=true

# -------------------------------------------------------------------- llm
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Cheap and fast for bulk page extraction.
EXTRACTION_MODEL=gemini-3.6-flash
# Used for preference parsing and honesty evaluation, where nuance matters.
REASONING_MODEL=gemini-3.6-flash
# Speech-to-speech model driving the phone conversation. Needs OPENAI_API_KEY
# regardless of LLM_PROVIDER — the Realtime API is OpenAI's.
REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
REALTIME_VOICE=alloy

# ------------------------------------------------------- telephony (CALL-E)
# mock  = simulated calls from a fixture. Free, instant, and exercises the whole
#         downstream pipeline. Use this until you have credits.
# calle = real outbound calls through CALL-E.
TELEPHONY_PROVIDER=mock
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
# How long to wait for one call to finish, and how often to poll while waiting.
CALLE_TIMEOUT_SECONDS=600
CALLE_POLL_SECONDS=2
CALL_REGION=IN
CALL_LOCALE=en-IN

# --------------------------------------------------------------- scraping
MAX_SITES_PER_SEARCH=5
MAX_LISTINGS_PER_SITE=25
SCRAPE_TIMEOUT_MS=30000
SCRAPE_CONCURRENCY=3

# ---------------------------------------------------------- call policy
MAX_CONCURRENT_CALLS=3
MAX_CALLS_PER_SESSION=20
# Do not dial the same number twice inside this window, across all customers.
NUMBER_COOLDOWN_DAYS=7
# TRAI-friendly hours, IST. A malformed value falls back to this default rather
# than leaving an empty list, which would permit calling at 3am.
CALL_WINDOWS_IST=11:00-13:00,17:00-20:00
# 1 during development only.
IGNORE_CALL_WINDOW=false
CALL_MAX_SECONDS=300

# --------------------------------------------------- admin notifications
# Either channel alone is enough. With neither, agency leads are still stored
# in Firestore but nobody is told about them — the miss is logged loudly.
ADMIN_NOTIFICATION_WEBHOOK_URL=
ADMIN_NOTIFICATION_EMAIL=
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=Khoj <onboarding@resend.dev>

# ------------------------------------------------------------------- auth
# Firebase Authentication with Google Sign-In. The browser completes sign-in and
# sends the ID token; this server verifies it with the Admin SDK.
# 1 makes every customer endpoint require a signed-in user.
AUTH_REQUIRED=false
# Fixed bearer token accepted as a session, for automated tests only.
DEV_AUTH_TOKEN=

# Developer escape hatch: skip the calling window AND the per-number cooldown.
# The cooldown is the one that bites in testing — a repeat call to the same
# number inside NUMBER_COOLDOWN_DAYS is marked BLOCKED and never dialled, which
# looks exactly like "the phone never rang". Never enable in production.
BYPASS_CALL_WINDOW=false
